{
  "appId": "com.aidialer.app",
  "appName": "AI DIALER",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "android": {
    "allowMixedContent": true
  },
  "plugins": {
    "Geolocation": {
      "permissions": ["location", "coarseLocation"]
    },
    "Microphone": {
      "permissions": ["microphone"]
    }
  }
}
